---
import type { PortalEntry } from "../lib/schema.ts";
import { getHostname } from "../lib/portals.ts";
import TrustBadge from "./TrustBadge.astro";

interface Props {
  portal: PortalEntry;
}

const { portal } = Astro.props;
const host = getHostname(portal.primaryUrl);
const detailHref = `/services/${portal.slug}/`;
---

<li
  class="portal-item"
  data-portal-card
  data-slug={portal.slug}
  data-category={portal.category}
  data-coverage={portal.coverage}
>
  <article class="portal-row">
    <div class="row-main">
      <div class="row-head">
        <h2 class="row-title">
          <a href={detailHref}>{portal.title}</a>
        </h2>
        <span class="row-domain">{host}</span>
      </div>

      <p class="row-summary">{portal.summary}</p>

      <div class="row-meta">
        {portal.popular && (
          <>
            <span class="row-popular">Popular</span>
            <span class="meta-sep" aria-hidden="true">·</span>
          </>
        )}
        <span class="row-agency">
          {portal.agencyShort}{portal.coverage === "city" && portal.cityName ? ` · ${portal.cityName}` : ""}
        </span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <TrustBadge tier={portal.trustTier} />
        {portal.scamWarning && (
          <>
            <span class="meta-sep" aria-hidden="true">·</span>
            <a href={`${detailHref}#scam-heading`} class="row-warn">
              Scam warning
            </a>
          </>
        )}
      </div>
    </div>

    <div class="row-actions">
      <a
        href={portal.primaryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-launch"
        aria-label={`${portal.primaryActionLabel} (${host})`}
      >
        <span>Open</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        </svg>
      </a>
      <a href={detailHref} class="row-details-link">
        Details<span class="visually-hidden"> &amp; safety for {portal.title}</span>
      </a>
    </div>
  </article>
</li>
