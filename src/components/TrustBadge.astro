---
import type { TrustTier } from "../lib/schema.ts";

interface Props {
  tier: TrustTier;
}

const { tier } = Astro.props;

const meta: Record<TrustTier, { label: string; className: string; icon: "shield" | "check" | "partner" }> = {
  "official-gov-ph": {
    label: ".gov.ph Verified",
    className: "trust-badge trust-badge--gov",
    icon: "shield",
  },
  "official-non-gov-domain": {
    label: "Official Portal",
    className: "trust-badge trust-badge--official",
    icon: "check",
  },
  "official-partner": {
    label: "Authorized Partner",
    className: "trust-badge trust-badge--partner",
    icon: "partner",
  },
};

const current = meta[tier];
---

<span class={current.className}>
  {current.icon === "shield" && (
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
      <path d="m9 12 2 2 4-4" />
    </svg>
  )}
  {current.icon === "check" && (
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="m9 12 2 2 4-4" />
    </svg>
  )}
  {current.icon === "partner" && (
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M12 8v4" />
      <path d="M12 16h.01" />
    </svg>
  )}
  <span>{current.label}</span>
</span>
