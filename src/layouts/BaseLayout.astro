---
import "../styles/global.css";
import { SITE_CONFIG, buildSuggestUrl } from "../lib/site.ts";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = SITE_CONFIG.tagline,
  currentPath = "/",
} = Astro.props;

const suggestUrl = buildSuggestUrl();
const fullTitle = title === SITE_CONFIG.name ? `${SITE_CONFIG.name} — Verified Philippine Government Portals` : `${title} | ${SITE_CONFIG.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="google-site-verification" content="ZH-a8arco594_47WcEmuwGkfw3Ky9yl1VHhoKgP_6SQ" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("color-scheme");
        if (saved === "light" || saved === "dark") {
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.setAttribute("content", saved);
          document.documentElement.dataset.colorScheme = saved;
          document.documentElement.style.colorScheme = saved;
        }
      } catch {}
    </script>
    <meta name="theme-color" content="#F6F5F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111315" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <a href="#main-heading" class="skip-link">Skip to main content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <g fill="currentColor">
                <path d="M12 1 13.4 6.6 12 5.6 10.6 6.6Z" />
                <path d="M12 23 13.4 17.4 12 18.4 10.6 17.4Z" />
                <path d="M23 12 17.4 13.4 18.4 12 17.4 10.6Z" />
                <path d="M1 12 6.6 13.4 5.6 12 6.6 10.6Z" />
                <g transform="rotate(45 12 12)">
                  <path d="M12 2.2 13.1 6.8 12 6 10.9 6.8Z" />
                  <path d="M12 21.8 13.1 17.2 12 18 10.9 17.2Z" />
                  <path d="M21.8 12 17.2 13.1 18 12 17.2 10.9Z" />
                  <path d="M2.2 12 6.8 13.1 6 12 6.8 10.9Z" />
                </g>
              </g>
              <circle cx="12" cy="12" r="3" class="brand-sun-core" />
            </svg>
          </span>
          <span>{SITE_CONFIG.name}</span>
        </a>

        <div class="header-controls">
          <nav class="site-nav" aria-label="Primary">
            <ul>
              <li>
                <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>
                  Directory
                </a>
              </li>
              <li>
                <a href="/trust/" aria-current={currentPath === "/trust/" ? "page" : undefined}>
                  Verify
                </a>
              </li>
              <li>
                <a href={suggestUrl} target="_blank" rel="noopener noreferrer">
                  Suggest
                </a>
              </li>
            </ul>
          </nav>

          <button
            id="theme-toggle"
            type="button"
            class="theme-toggle"
            aria-label="Toggle color scheme"
          >
            <span class="theme-opt theme-opt--to-dark">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
              </svg>
              <span class="visually-hidden">Switch to dark theme</span>
            </span>
            <span class="theme-opt theme-opt--to-light">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2" />
                <path d="M12 20v2" />
                <path d="m4.93 4.93 1.41 1.41" />
                <path d="m17.66 17.66 1.41 1.41" />
                <path d="M2 12h2" />
                <path d="M20 12h2" />
                <path d="m6.34 17.66-1.41 1.41" />
                <path d="m19.07 4.93-1.41 1.41" />
              </svg>
              <span class="visually-hidden">Switch to light theme</span>
            </span>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>{SITE_CONFIG.disclaimer}</p>
        <div class="footer-links">
          <a href="/trust/">Trust &amp; verification policy</a>
          <a href={suggestUrl} target="_blank" rel="noopener noreferrer">
            Suggest a missing portal
          </a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById("theme-toggle");
        const meta = document.querySelector('meta[name="color-scheme"]');
        if (!(btn instanceof HTMLButtonElement) || !(meta instanceof HTMLMetaElement)) return;

        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const getSystem = () => (media.matches ? "dark" : "light");
        const getEffective = () =>
          meta.content === "dark" || meta.content === "light" ? meta.content : getSystem();

        const applyScheme = (value) => {
          if (value === "light" || value === "dark") {
            meta.content = value;
            document.documentElement.dataset.colorScheme = value;
            document.documentElement.style.colorScheme = value;
          } else {
            meta.content = "light dark";
            delete document.documentElement.dataset.colorScheme;
            document.documentElement.style.colorScheme = "";
          }
        };

        btn.addEventListener("click", () => {
          const target = getEffective() === "dark" ? "light" : "dark";
          const system = getSystem();
          if (target === system) {
            applyScheme("light dark");
            try {
              localStorage.removeItem("color-scheme");
            } catch {}
          } else {
            applyScheme(target);
            try {
              localStorage.setItem("color-scheme", target);
            } catch {}
          }
        });

        window.addEventListener("storage", (event) => {
          if (event.key !== "color-scheme") return;
          applyScheme(event.newValue);
        });
      })();
    </script>
  </body>
</html>
